# Real Node API is the default. "localhost" is swapped for this computer's LAN IP in dev,
# so phones on the same Wi-Fi can reach it (backend must listen on 0.0.0.0).
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
# Set to true to use the mock JSON backend (mock/data/*.json) instead of the API.
EXPO_PUBLIC_USE_MOCKS=false
