{
  "expo": {
    "name": "PawsNPlay",
    "slug": "pawsnplay",
    "version": "1.0.0",
    "scheme": "pawsnplay",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.pawsnplay.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.pawsnplay.app"
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Paws N' Play to attach vaccination records from your photos.",
          "cameraPermission": "Allow Paws N' Play to photograph vaccination records."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
